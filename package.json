{
  "name": "kessler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "snapshot": "node scripts/snapshot.mjs",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "satellite.js": "^7.1.0",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/d3-geo": "^3.1.1",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
